{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192",
        "GRADLE_OPTS": "-Xmx6g -Xms2g -XX:MaxMetaspaceSize=512m -XX:+HeapDumpOnOutOfMemoryError",
        "EXPO_NO_TELEMETRY": "1",
        "EAS_NO_VCS": "1"
      }
    },
    "development": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "prebuildCommand": "npx expo prebuild --clean && npx react-native start --reset-cache &"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "cache": {
        "disabled": true
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease --no-daemon --stacktrace",
        "ccache": false,
        "prebuildCommand": "npx expo prebuild --clean"
      }
    },
    "preview-safe": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease --no-daemon",
        "image": "latest",
        "ndk": "26.1.10909125",
        "ccache": false,
        "prebuildCommand": "npx expo prebuild --clean"
      }
    },
    "preview-debug": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease --no-daemon --info --stacktrace"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease --no-daemon",
        "prebuildCommand": "npx expo prebuild --clean"
      },
      "ios": {
        "image": "latest"
      }
    },
    "production-safe": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease --no-daemon --stacktrace",
        "prebuildCommand": "npx expo prebuild --clean"
      }
    }
  },
  "submit": {
    "internal": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft",
        "changesNotSentForReview": false
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production",
        "releaseStatus": "completed",
        "changesNotSentForReview": false
      },
      "ios": {
        "appleId": "contact@onspace.ai",
        "ascAppId": "com.butlerai.pc.automation",
        "appleTeamId": "YOUR_APPLE_TEAM_ID"
      }
    }
  }
}
